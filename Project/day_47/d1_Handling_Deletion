// add new customer name and his order
const addCust= async()=>{
    let newCust= new Customer({
        name: "karan Arjun"
    });
    
    let newOrder= new Order({
        item: "Pizza",
        price:250
    }); 

    newCust.orders.push(newOrder);
    await newOrder.save();
    await newCust.save();
    console.log("added new customer");
};
addCust();

