// show route, UPDATE ONLY populate method
app.get("/listings/:id", wrapAsync(async(req,res)=>{
    let {id}= req.params;
    const listing= await Listing.findById(id).populate("reviews");
    res.render("listings/show.ejs",{listing});
}));



