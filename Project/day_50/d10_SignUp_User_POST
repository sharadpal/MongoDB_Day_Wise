router.post("/signup", wrapAsyc (async(req,res)=>{
    try{
        let {username,email,password}=req.body; // abstracting the data from req.body
        const newUser=new User({email,username}); // creating new user
        const registeredUser= await User.register(newUser,password); // registering the user with password
        console.log(registeredUser);
        req.flash("success","Welcome to Wanderlust!");
        res.redirect("/listings");
    } catch(e){
        req.flash("error",e.message);
        res.redirect("/signup");
    }
}));
