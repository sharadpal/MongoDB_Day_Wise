app.use(
    session({
        secret:"mysupersecretstring",
        resave:false,
        saveUninitialized:true
    })
);

app.get("/reqcount",(req,res)=>{
    if(req.session.count){
        req.session.count++;
    }
    else req.session.count=1;
    res.send(`you sent a request ${req.session.count} times`);
});
